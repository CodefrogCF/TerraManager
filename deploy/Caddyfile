{
    default_sni {$TM_HOST}
}

https://{$TM_HOST} {
    tls /certs/server.crt /certs/server.key
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer
    header Cache-Control no-store

    handle /api/* {
        # SSE is flushed automatically for text/event-stream. Keep default client
    # cancellation: flush_interval -1 would retain abandoned upstream streams.
    # Do not enable response_buffers or compression for this route.
    reverse_proxy server:8080 {
            health_uri /api/v1/health
        }
    }

    handle {
        root * /srv/web
        file_server
    }
}
