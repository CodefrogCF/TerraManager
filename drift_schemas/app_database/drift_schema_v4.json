  "fixed_sql": [
    {
      "name": "media_assets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"media_assets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"file_name\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"data\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "boxes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"boxes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"qr_id\" TEXT NOT NULL UNIQUE, \"width_cm\" REAL NULL, \"height_cm\" REAL NULL, \"depth_cm\" REAL NULL, \"picture_media_id\" INTEGER NULL REFERENCES media_assets (id), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "animals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"animals\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"box_id\" INTEGER NULL REFERENCES boxes (id), \"status\" TEXT NOT NULL DEFAULT 'active', \"common_name\" TEXT NOT NULL, \"latin_name\" TEXT NOT NULL, \"sex\" TEXT NULL, \"birth_date\" INTEGER NULL, \"birth_date_accuracy\" TEXT NULL, \"temp_min\" REAL NOT NULL, \"temp_max\" REAL NOT NULL, \"humidity_min\" REAL NOT NULL, \"humidity_max\" REAL NOT NULL, \"picture_path\" TEXT NULL, \"picture_media_id\" INTEGER NULL REFERENCES media_assets (id), \"notes\" TEXT NULL, \"archive_reason\" TEXT NULL, \"archived_at\" INTEGER NULL, \"archive_notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "feeding_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feeding_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"animal_id\" INTEGER NOT NULL REFERENCES animals (id), \"fed_at\" INTEGER NOT NULL, \"notes\" TEXT NULL);"
        }
      ]
    }
