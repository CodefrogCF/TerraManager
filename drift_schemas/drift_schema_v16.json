  "fixed_sql": [
    {
      "name": "media_assets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"media_assets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"file_name\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"data\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "boxes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"boxes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"qr_id\" TEXT NOT NULL UNIQUE, \"status\" TEXT NOT NULL DEFAULT 'active', \"archive_reason\" TEXT NULL, \"archived_at\" INTEGER NULL, \"archive_notes\" TEXT NULL, \"name\" TEXT NULL, \"width_cm\" REAL NULL, \"height_cm\" REAL NULL, \"depth_cm\" REAL NULL, \"temperature_zones\" TEXT NULL, \"notes\" TEXT NULL, \"picture_media_id\" INTEGER NULL REFERENCES media_assets (id), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "animals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"animals\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"box_id\" INTEGER NULL REFERENCES boxes (id), \"status\" TEXT NOT NULL DEFAULT 'active', \"common_name\" TEXT NOT NULL, \"latin_name\" TEXT NOT NULL, \"category\" TEXT NOT NULL DEFAULT 'other', \"subcategory\" TEXT NULL, \"sex\" TEXT NULL, \"birth_date\" INTEGER NULL, \"birth_date_accuracy\" TEXT NULL, \"temp_min\" REAL NOT NULL, \"temp_max\" REAL NOT NULL, \"nighttime_temperature\" REAL NULL, \"nighttime_temperature_min\" REAL NULL, \"nighttime_temperature_max\" REAL NULL, \"humidity_min\" REAL NOT NULL, \"humidity_max\" REAL NOT NULL, \"origin_habitat\" TEXT NULL, \"weight\" TEXT NULL, \"shedding_notes\" TEXT NULL, \"rest_or_dormancy_periods\" TEXT NULL, \"temperature_zones\" TEXT NULL, \"picture_path\" TEXT NULL, \"picture_media_id\" INTEGER NULL REFERENCES media_assets (id), \"notes\" TEXT NULL, \"archive_reason\" TEXT NULL, \"archived_at\" INTEGER NULL, \"archive_notes\" TEXT NULL, \"feeding_reminder_interval_days\" INTEGER NULL, \"feeding_reminder_baseline\" INTEGER NULL, \"show_weight_on_detail\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_weight_on_detail\" IN (0, 1)), \"show_shedding_on_detail\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_shedding_on_detail\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "animal_weight_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"animal_weight_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"animal_id\" INTEGER NOT NULL REFERENCES animals (id) ON DELETE CASCADE, \"weight_grams\" REAL NOT NULL, \"measured_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "shedding_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shedding_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"animal_id\" INTEGER NOT NULL REFERENCES animals (id) ON DELETE CASCADE, \"shed_at\" INTEGER NOT NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "feeding_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feeding_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"animal_id\" INTEGER NOT NULL REFERENCES animals (id), \"fed_at\" INTEGER NOT NULL, \"notes\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "animal_picture_associations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"animal_picture_associations\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"animal_id\" INTEGER NOT NULL REFERENCES animals (id) ON DELETE CASCADE, \"media_asset_id\" INTEGER NOT NULL REFERENCES media_assets (id) ON DELETE CASCADE, \"captured_at\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL, UNIQUE (\"media_asset_id\"), UNIQUE (\"animal_id\", \"sort_order\"));"
        }
      ]
    },
